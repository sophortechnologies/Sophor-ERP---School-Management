generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                 @id @default(autoincrement())
  username                 String              @unique
  email                    String              @unique
  passwordHash             String
  firstName                String?
  lastName                 String?
  phone                    String?
  roleId                   Int
  isActive                 Boolean             @default(true)
  lastLogin                DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  profileImage             String?
  passwordChangedAt        DateTime?
  passwordExpiresAt        DateTime?
  emailVerified            Boolean             @default(false)
  emailVerifyExpires       DateTime?
  emailVerifyToken         String?
  employees          Employee[]   
  recordedAttendances      Attendance[]
  bookIssues               BookIssue[]
  calendarEvents           CalendarEvent[]     @relation("UserCalendarEvents")
  receivedMessages         ChatMessage[]       @relation("ChatReceiver")
  sentMessages             ChatMessage[]       @relation("ChatSender")
  timetables               ClassTimetable[]
  examResults              ExamResult[]        @relation("EnteredExamResults")
  verifiedResults          ExamResult[]        @relation("VerifiedExamResults")
  notifications            Notification[]
  sectionSubjects          SectionSubject[]
  sessions                 Session[]
  teacher                  Teacher?
  teacherAssignments       TeacherAssignment[] @relation("UserTeacherAssignments")
  UserPermission           UserPermission[]
  userSessions             UserSession[]
  admissionTests           AdmissionTest[]
  auditLogs                AuditLog[]
  createdExams             Exam[]
  parents                  Parent?
  payslips                 Payslip[]
  salaryStructures         SalaryStructure[]
  staff                    Staff?
  recordedStaffAttendances StaffAttendance[]   @relation("AttendanceRecorder")
  staffAttendances         StaffAttendance[]
  leaveBalances            StaffLeaveBalance[]
  approvedLeaves           StaffLeave[]        @relation("LeaveApprover")
  leaveRequests            StaffLeave[]
  studentDocuments         StudentDocument[]
  assignedStudents         Student[]           @relation("StudentAssignedBy")
  createdStudents          Student[]           @relation("StudentCreatedBy")
  student                  Student?
  role                     Role                @relation(fields: [roleId], references: [id])
  assetsAssigned     Asset[]       @relation("AssetAssignedToUser")
  
  budgetTransfersRequested BudgetTransfer[] @relation("BudgetTransferRequestedBy")
  budgetTransfersApproved BudgetTransfer[] @relation("BudgetTransferApprovedBy")
  budgetAlertsResolved BudgetAlert[] @relation("BudgetAlertResolvedBy")
  budgetForecastsGenerated BudgetForecast[] @relation("BudgetForecastGeneratedBy")

  @@map("user")
}

model Role {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  code           String           @unique
  description    String?
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  permissions    Json?
  RolePermission RolePermission[]
  users          User[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  conditions   Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  description     String?
  resource        String
  action          String
  scope           String           @default("all")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([resource, action, scope], name: "resource_action_scope")
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  conditions   Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model SchoolConfiguration {
  id            Int      @id @default(autoincrement())
  schoolName    String
  address       String?
  phone         String?
  email         String?
  website       String?
  academicYear  String
  startDate     DateTime
  endDate       DateTime
  currency      String?
  logo          String?
  motto         String?
  principalName String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true)
  headId      Int?      @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  head        Teacher?  @relation("DepartmentHead", fields: [headId], references: [id])
  subjects    Subject[]
  teachers    Teacher[] @relation("TeacherDepartment")
  staff       Staff[]
  assetsAssigned     Asset[]       @relation("AssetAssignedToDepartment")
  budgets            Budget[]  
  employees          Employee[]   
    
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  name               String
  code               String              @unique
  description        String?
  isActive           Boolean             @default(true)
  departmentId       Int?
  createdBy          Int?
  updatedBy          Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  type               SubjectType         @default(CORE)
  attendances        Attendance[]
  timetables         ClassTimetable[]
  examResults        ExamResult[]
  examSubjects       ExamSubject[]
  grades             Grade[]
  sectionSubjects    SectionSubject[]
  department         Department?         @relation(fields: [departmentId], references: [id])
  teacherAssignments TeacherAssignment[] @relation("SubjectTeacherAssignments")
  subjects         ClassSubject[]  

}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entityType  String
  entityId    Int
  description String
  oldValues   Json?
  newValues   Json?
  timestamp   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AcademicSession {
  id                         Int                         @id @default(autoincrement())
  name                       String
  startDate                  DateTime
  endDate                    DateTime
  isActive                   Boolean                     @default(false)
  admissionClasses           AdmissionClass[]
  Class                      Class[]
  classAutoAssignmentConfigs ClassAutoAssignmentConfig[]
  holidays                   Holiday[]
  reportCards                ReportCard[]
  attendanceSummaries        AttendanceSummary[]
  exams                      Exam[]
  students                   Student[]
  timetableArchives  TimetableArchive[]  


  @@map("academic_sessions")
}

model Section {
  id              Int              @id @default(autoincrement())
  name            String
  capacity        Int?
  classId         Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  timetables      ClassTimetable[]
  class           Class            @relation(fields: [classId], references: [id])
  sectionSubjects SectionSubject[]
  students        Student[]
  timetableArchives  TimetableArchive[]  

}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  grade              String?
  academicSessionId  Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  AdmissionClass     AdmissionClass[]
  Attendance         Attendance[]
  billConfigurations BillConfiguration[]
  academicSession    AcademicSession?    @relation(fields: [academicSessionId], references: [id])
  ReportCard         ReportCard[]
  Section            Section[]
  teacherAssignments TeacherAssignment[] @relation("ClassTeacherAssignments")
  AttendanceSummary  AttendanceSummary[]
  Exam               Exam[]
  students           Student[]
  subjects         ClassSubject[]  

}

model ClassSubject {
  id        Int      @id @default(autoincrement())
  classId   Int
  subjectId Int
  
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  
  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Student {
  id                     Int                     @id @default(autoincrement())
  studentId              String                  @unique
  userId                 Int                     @unique
  dateOfBirth            DateTime
  gender                 String
  identificationNumber   String?                 @unique
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  nationality            String?
  guardianName           String
  guardianPhone          String
  guardianEmail          String?
  guardianRelation       String
  guardianOccupation     String?
  guardianAddress        String?
  previousSchool         String?
  lastGradeCompleted     String?
  previousAcademicYear   String?
  lastGradeMarks         String?
  admissionTestDate      DateTime?
  admissionTestScore     Float?
  admissionTestResult    String?
  admissionRemarks       String?
  admissionCategory      String?
  sessionId              Int?
  classId                Int?
  sectionId              Int?
  status                 String                  @default("INQUIRY")
  remarks                String?
  admissionDate          DateTime                @default(now())
  admissionStatus        String?
  admissionPassed        Boolean?
  assignedAt             DateTime?
  assignedBy             Int?
  assignedByAuto         Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  createdBy              Int?
  updatedBy              Int?
  deletedBy              Int?
  email                  String?                 @unique
  firstName              String
  lastName               String
  phone                  String?
  attendance             Attendance[]
  bills                  Bill[]
  examResults            ExamResult[]
  grades                 Grade[]
  notifications          Notification[]
  payments               Payment[]
  reportCards            ReportCard[]
  admissionTests         AdmissionTest[]
  attendanceSummaries    AttendanceSummary[]
  educationalBackgrounds EducationalBackground[]
  documents              StudentDocument[]
  refundRequests     RefundRequest[]
  studentParents         StudentParent[]
  assignedByUser         User?                   @relation("StudentAssignedBy", fields: [assignedBy], references: [id])
  class                  Class?                  @relation(fields: [classId], references: [id])
  createdByUser          User?                   @relation("StudentCreatedBy", fields: [createdBy], references: [id])
  section                Section?                @relation(fields: [sectionId], references: [id])
  session                AcademicSession?        @relation(fields: [sessionId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])

  @@index([classId, sectionId])
  @@index([sessionId])
  @@map("students")
}

model AdmissionTest {
  id            Int       @id @default(autoincrement())
  studentId     Int
  testType      String?
  score         Float?
  testDate      DateTime?
  testResult    String?
  remarks       String?
  createdAt     DateTime  @default(now())
  createdBy     Int
  createdByUser User      @relation(fields: [createdBy], references: [id])
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("admission_tests")
}

model ClassAutoAssignmentConfig {
  id              Int             @id @default(autoincrement())
  sessionId       Int
  criteria        Json
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  academicSession AcademicSession @relation(fields: [sessionId], references: [id])
}

model EducationalBackground {
  id            Int      @id @default(autoincrement())
  studentId     Int
  institution   String
  qualification String
  yearCompleted Int
  grade         String?
  createdAt     DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("educational_backgrounds")
}

model StudentInquiry {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  email           String
  phone           String
  interestedClass String
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

model StudentDocument {
  id             Int      @id @default(autoincrement())
  studentId      Int
  documentType   String
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  description    String?
  uploadedBy     Int
  uploadedAt     DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id])
  uploadedByUser User     @relation(fields: [uploadedBy], references: [id])

  @@map("student_documents")
}

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  classId   Int
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  subjectId Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    Int?
  class     Class            @relation(fields: [classId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])
  subject   Subject?         @relation(fields: [subjectId], references: [id])
  User      User?            @relation(fields: [userId], references: [id])

  @@unique([studentId, classId, date])
}

model Teacher {
  id               Int            @id @default(autoincrement())
  userId           Int            @unique
  departmentId     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  address          String?
  dateOfBirth      DateTime?
  dateOfJoining    DateTime       @default(now())
  emergencyContact String?
  emergencyPhone   String?
  employmentType   EmploymentType @default(full_time)
  gender           Gender         @default(male)
  qualification    Qualification  @default(bachelor)
  salary           Decimal?
  specialization   String?
  status           TeacherStatus  @default(active)
  headedDepartment Department?    @relation("DepartmentHead")
  department       Department?    @relation("TeacherDepartment", fields: [departmentId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  bankName          String?
  accountNumber     String?
  ifscCode          String?
  panNumber         String?   @unique
  uanNumber         String?   @unique
  esiNumber         String?   @unique
  pfApplicable      Boolean   @default(true)
  esiApplicable     Boolean   @default(true)
  salaryStructureId Int?
  employeeId         Int?        @unique  
  employee           Employee?

}

model Staff {
  id             Int         @id @default(autoincrement())
  userId         Int         @unique
  employeeCode   String?     @unique
  designation    String
  employmentType String?
  joiningDate    DateTime?
  status         String      @default("ACTIVE")
  departmentId   Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  payrolls       Payroll[]
  department     Department? @relation(fields: [departmentId], references: [id])
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    // Add to both models
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  panNumber         String?   @unique
  uanNumber         String?   @unique
  esiNumber         String?   @unique
  pfApplicable      Boolean   @default(true)
  esiApplicable     Boolean   @default(true)
  salaryStructureId Int?
  employeeId         Int?        @unique  
  employee           Employee?

  

  @@map("staff")
}

model AttendanceSummary {
  id                Int             @id @default(autoincrement())
  studentId         Int
  classId           Int
  academicSessionId Int
  month             Int
  year              Int
  totalDays         Int
  presentDays       Int
  absentDays        Int
  lateDays          Int
  halfDays          Int
  percentage        Float
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  student           Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, academicSessionId, month, year], name: "student_month_summary")
  @@map("attendance_summary")
}

model TeacherAssignment {
  id        Int      @id @default(autoincrement())
  teacherId Int
  classId   Int
  subjectId Int?
  class     Class    @relation("ClassTeacherAssignments", fields: [classId], references: [id])
  subject   Subject? @relation("SubjectTeacherAssignments", fields: [subjectId], references: [id])
  teacher   User     @relation("UserTeacherAssignments", fields: [teacherId], references: [id])
}

model ExamType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  weightage   Decimal  @db.Decimal(5, 2)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  exams       Exam[]
}

model Exam {
  id                Int             @id @default(autoincrement())
  name              String
  examTypeId        Int  
  classId           Int
  academicSessionId Int
  academicYear      String
  term              String
  startDate         DateTime
  endDate           DateTime
  description       String?
  isPublished       Boolean         @default(false)
  isActive          Boolean         @default(true)
  status            String          @default("SCHEDULED")
  totalWeightage    Decimal?        @db.Decimal(5, 2)
  passingCriteria   String?
  instructions      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         Int
  examResults       ExamResult[]
  examSubjects      ExamSubject[]
  grades            Grade[]
  reportCards       ReportCard[]
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  createdByUser     User            @relation(fields: [createdBy], references: [id])
  examType          ExamType        @relation(fields: [examTypeId], references: [id])

  @@index([classId, academicSessionId, term])
  @@index([startDate, endDate])
  @@index([classId, academicYear, term])
  @@map("exams")
}

model ExamSubject {
  id             Int      @id @default(autoincrement())
  examId         Int
  subjectId      Int
  examDate       DateTime
  startTime      String
  endTime        String
  duration       Int
  maxMarks       Int
  minMarks       Int
  isTheory       Boolean  @default(true)
  isPractical    Boolean  @default(false)
  practicalMarks Int?
  theoryMarks    Int?
  roomNumber     String?
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id])

  @@unique([examId, subjectId])
}

model ExamResult {
  id             Int      @id @default(autoincrement())
  examId         Int
  studentId      Int
  subjectId      Int
  theoryMarks    Decimal? @db.Decimal(5, 2)
  practicalMarks Decimal? @db.Decimal(5, 2)
  totalMarks     Decimal  @db.Decimal(5, 2)
  maxMarks       Int
  percentage     Decimal  @db.Decimal(5, 2)
  grade          String
  remarks        String?
  isAbsent       Boolean  @default(false)
  enteredBy      Int
  verifiedBy     Int?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  enteredByUser  User     @relation("EnteredExamResults", fields: [enteredBy], references: [id])
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id])
  subject        Subject  @relation(fields: [subjectId], references: [id])
  verifiedByUser User?    @relation("VerifiedExamResults", fields: [verifiedBy], references: [id])

  @@unique([examId, studentId, subjectId])
  @@index([studentId, examId])
}

model Grade {
  id            Int      @id @default(autoincrement())
  studentId     Int
  examId        Int
  subjectId     Int
  marksObtained Decimal  @db.Decimal(5, 2)
  maxMarks      Decimal  @db.Decimal(5, 2)
  grade         String
  gradePoint    Decimal? @db.Decimal(3, 2)
  percentage    Decimal  @db.Decimal(5, 2)
  isPassed      Boolean  @default(true)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])

  @@unique([studentId, examId, subjectId])
  @@index([studentId, examId])
  @@index([subjectId, examId])
}


model PaymentReminder {
  id              Int      @id @default(autoincrement())
  billId          Int
  reminderType    String   // DUE_SOON, OVERDUE, URGENT
  daysBeforeDue   Int?     // 7, 3, 1
  daysAfterDue    Int?     // 3, 7, 15
  sentAt          DateTime @default(now())
  sentVia         String   // EMAIL, SMS
  status          String   // SENT, DELIVERED, FAILED
  
  bill            Bill     @relation(fields: [billId], references: [id])
}


model BankReconciliation {
  id              Int      @id @default(autoincrement())
  reconciliationDate DateTime @default(now())
  bankStatementDate DateTime
  totalPayments   Decimal  @db.Decimal(12,2)
  totalBankEntries Decimal @db.Decimal(12,2)
  difference      Decimal  @db.Decimal(12,2)
  status          String   // PENDING, COMPLETED, DISCREPANCY
  reportUrl       String?
  completedBy     Int?
  completedAt     DateTime?
  items              ReconciliationItem[]
}

model BankFile {
  id                Int       @id @default(autoincrement())
  payrollRunId      Int
  bankName          String
  fileFormat        String
  fileUrl           String
  totalAmount       Decimal   @db.Decimal(12,2)
  totalTransactions Int
  generatedBy       Int
  generatedAt       DateTime  @default(now())
  uploadedToBank    Boolean   @default(false)
  uploadResponse    Json?
  
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id])
  
  @@map("bank_files")
}


model ReconciliationItem {
  id              Int      @id @default(autoincrement())
  reconciliationId Int
  paymentId       Int?
  bankReference   String?
  amount          Decimal  @db.Decimal(10,2)
  matchStatus     String   // MATCHED, UNMATCHED, DISCREPANCY
  discrepancyReason String?
  
  reconciliation  BankReconciliation @relation(fields: [reconciliationId], references: [id])
  payment         Payment?           @relation(fields: [paymentId], references: [id])
}
model ReportCard {
  id                Int             @id @default(autoincrement())
  studentId         Int
  examId            Int
  classId           Int
  academicSessionId Int
  totalMarks        Decimal         @db.Decimal(6, 2)
  obtainedMarks     Decimal         @db.Decimal(6, 2)
  percentage        Decimal         @db.Decimal(5, 2)
  finalGrade        String
  rank              Int?
  remarks           String?
  isPublished       Boolean         @default(false)
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  class             Class           @relation(fields: [classId], references: [id])
  exam              Exam            @relation(fields: [examId], references: [id])
  student           Student         @relation(fields: [studentId], references: [id])

  @@unique([studentId, examId])
  @@index([studentId, academicSessionId])
}

model GradeScale {
  id          Int      @id @default(autoincrement())
  grade       String   @unique
  minPercent  Decimal  @db.Decimal(5, 2)
  maxPercent  Decimal  @db.Decimal(5, 2)
  gradePoint  Decimal  @db.Decimal(3, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdmissionClass {
  id                 Int             @id @default(autoincrement())
  admissionSessionId Int
  classId            Int
  availableSeats     Int
  appliedSeats       Int             @default(0)
  status             String          @default("open")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  academicSession    AcademicSession @relation(fields: [admissionSessionId], references: [id])
  class              Class           @relation(fields: [classId], references: [id])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model Holiday {
  id                Int              @id @default(autoincrement())
  name              String
  date              DateTime
  createdAt         DateTime         @default(now())
  academicSessionId Int?
  isHalfDay         Boolean          @default(false)
  type              HolidayType      @default(SCHOOL)
  academicSession   AcademicSession? @relation(fields: [academicSessionId], references: [id])

  @@unique([date, academicSessionId])
}

model Parent {
  id        Int             @id @default(autoincrement())
  userId    Int             @unique
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
