model Budget {
  id                    Int               @id @default(autoincrement())
  budgetCode            String            @unique
  fiscalYear            String
  
  // Hierarchy
  parentId              Int?
  departmentId          Int?
  costCenter            String?
  
  // Classification
  category              String            // SALARIES, OPERATIONAL, CAPITAL, REVENUE, etc.
  subCategory           String?
  budgetType            String            @default("ANNUAL") // ANNUAL, QUARTERLY, PROJECT_BASED
  
  // Amounts (Three states)
  allocatedAmount       Decimal           @db.Decimal(12,2)
  committedAmount       Decimal           @db.Decimal(12,2) @default(0)
  actualAmount          Decimal           @db.Decimal(12,2) @default(0)
  availableAmount       Decimal           @db.Decimal(12,2)
  
  // Control thresholds
  softStopPercent       Int               @default(80)
  hardStopPercent       Int               @default(100)
  alertEmail            String?
  
  // Approval workflow
  status                String            @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, FROZEN
  submittedBy           Int?
  submittedAt           DateTime?
  approvedBy            Int?
  approvedAt            DateTime?
  rejectionReason       String?
  frozenAt              DateTime?
  
  // Rollover rules
  allowRollover         Boolean           @default(false)
  rolloverToNextYear    Boolean           @default(false)
  
  // Metadata
  notes                 String?
  createdBy             Int
  createdAt             DateTime          @default(now())
  updatedBy             Int?
  updatedAt             DateTime          @updatedAt
  
  // Relations
  parent                Budget?           @relation("BudgetHierarchy", fields: [parentId], references: [id])
  department            Department?       @relation(fields: [departmentId], references: [id])
  children              Budget[]          @relation("BudgetHierarchy")
  commitments           BudgetCommitment[]
  actuals               BudgetActual[]
  transfersFrom         BudgetTransfer[]  @relation("FromBudget")
  transfersTo           BudgetTransfer[]  @relation("ToBudget")
  alerts                BudgetAlert[]
  forecasts             BudgetForecast[]

  
  @@index([fiscalYear])
  @@index([departmentId])
  @@index([category])
  @@index([status])
}

model BudgetCommitment {
  id                    Int               @id @default(autoincrement())
  budgetId              Int
  commitmentNumber      String            @unique
  referenceType         String            // PURCHASE_ORDER, CONTRACT, SALARY_APPROVAL
  referenceId           Int
  amount                Decimal           @db.Decimal(12,2)
  description           String?
  committedAt           DateTime          @default(now())
  committedBy           Int
  status                String            @default("ACTIVE") // ACTIVE, REALIZED, CANCELLED, EXPIRED
  realizedAt            DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  
  budget                Budget            @relation(fields: [budgetId], references: [id])
  
  @@index([budgetId])
  @@index([referenceType, referenceId])
}

model BudgetActual {
  id                    Int               @id @default(autoincrement())
  budgetId              Int
  actualNumber          String            @unique
  referenceType         String            // PAYMENT, EXPENSE, SALARY
  referenceId           Int
  amount                Decimal           @db.Decimal(12,2)
  description           String?
  recordedAt            DateTime          @default(now())
  recordedBy            Int
  approvedBy            Int?
  approvedAt            DateTime?
  
  budget                Budget            @relation(fields: [budgetId], references: [id])
  
  @@index([budgetId])
  @@index([referenceType, referenceId])
}

model BudgetTransfer {
  id                    Int               @id @default(autoincrement())
  transferNumber        String            @unique
  fromBudgetId          Int
  toBudgetId            Int
  amount                Decimal           @db.Decimal(12,2)
  reason                String
  justification         String?
  
  status                String            @default("PENDING")
  requestedBy           Int
  requestedAt           DateTime          @default(now())
  approvedBy            Int?
  approvedAt            DateTime?
  rejectionReason       String?
  executedAt            DateTime?
  
  fromBudget            Budget            @relation("FromBudget", fields: [fromBudgetId], references: [id])
  toBudget              Budget            @relation("ToBudget", fields: [toBudgetId], references: [id])
  
  requestedByUser       User              @relation("BudgetTransferRequestedBy", fields: [requestedBy], references: [id])
  approvedByUser        User?             @relation("BudgetTransferApprovedBy", fields: [approvedBy], references: [id])
  
  @@index([fromBudgetId])
  @@index([toBudgetId])
  @@index([status])
}

model BudgetAlert {
  id                    Int               @id @default(autoincrement())
  budgetId              Int
  alertType             String
  percentageUsed        Int
  threshold             Int
  message               String
  isResolved            Boolean           @default(false)
  resolvedAt            DateTime?
  resolvedBy            Int?
  createdAt             DateTime          @default(now())
  
  budget                Budget            @relation(fields: [budgetId], references: [id])
  resolvedByUser        User?             @relation("BudgetAlertResolvedBy", fields: [resolvedBy], references: [id])
  
  @@index([budgetId, isResolved])
}

model BudgetForecast {
  id                    Int               @id @default(autoincrement())
  budgetId              Int
  forecastDate          DateTime          @default(now())
  month                 Int
  year                  Int
  projectedSpend        Decimal           @db.Decimal(12,2)
  confidenceLevel       String
  assumptions           Json?
  generatedBy           Int
  
  budget                Budget            @relation(fields: [budgetId], references: [id])
  generatedByUser       User              @relation("BudgetForecastGeneratedBy", fields: [generatedBy], references: [id])
  
  @@unique([budgetId, month, year])
}


