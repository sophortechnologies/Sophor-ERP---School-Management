model Asset {
  id                    Int               @id @default(autoincrement())
  assetTag              String            @unique
  serialNumber          String?           @unique
  name                  String
  model                 String?
  manufacturer          String?
  
  // Classification
  category              String            // IT, FURNITURE, VEHICLE, LAB_EQUIPMENT, LIBRARY, BUILDING, SPORTS, OTHER
  subCategory           String?
  status                String            @default("ACTIVE") // ACTIVE, MAINTENANCE, RETIRED, DISPOSED, LOST
  
  // Purchase Information
  purchaseDate          DateTime
  purchaseCost          Decimal           @db.Decimal(12,2)
  purchaseOrderId       Int?
  vendorName            String?
  vendorContact         String?
  invoiceNumber         String?
  warrantyExpiry        DateTime?
  warrantyDetails       String?
  
  // Depreciation
  depreciationMethod    String            @default("STRAIGHT_LINE") // STRAIGHT_LINE, WRITTEN_DOWN_VALUE
  usefulLifeYears       Int               @default(5)
  salvageValue          Decimal           @db.Decimal(10,2) @default(0)
  currentValue          Decimal           @db.Decimal(12,2)
  accumulatedDepreciation Decimal         @db.Decimal(12,2) @default(0)
  lastDepreciationDate  DateTime?
  fullyDepreciated      Boolean           @default(false)
  
  // Location & Assignment
  currentLocation       String?
  rackNumber            String?
  assignedToUserId      Int?
  assignedToDepartmentId Int?
  assignedAt            DateTime?
  assignedBy            Int?
  
  // Maintenance
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  maintenanceInterval   Int?
  maintenanceCost       Decimal           @db.Decimal(12,2) @default(0)
  
  // Insurance
  insuranceProvider     String?
  insurancePolicyNo     String?
  insuranceExpiry       DateTime?
  insuranceAmount       Decimal?          @db.Decimal(12,2)
  
  // Documents
  documents             Json?
  photos                Json?
  
  // Audit
  notes                 String?
  createdBy             Int
  createdAt             DateTime          @default(now())
  updatedBy             Int?
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?
  
  // Relations
  assignedToUser        User?             @relation("AssetAssignedToUser", fields: [assignedToUserId], references: [id])
  assignedToDepartment  Department?       @relation("AssetAssignedToDepartment", fields: [assignedToDepartmentId], references: [id])
  depreciationHistory   DepreciationHistory[]
  maintenanceRecords    AssetMaintenance[]
  transfers             AssetTransfer[]
  disposals             AssetDisposal[]
  
  @@index([assetTag])
  @@index([category])
  @@index([status])
  @@index([assignedToUserId])
  @@index([nextMaintenanceDate])
}

model DepreciationHistory {
